#version 450

layout (local_size_x = 256) in;

layout (push_constant) uniform PC {
    int  count;
    float dt;
    float softening;
    float gravity;
} pc;

struct Particle {
    vec2 pos;
    vec2 vel;
};

layout (set = 0, binding = 0) buffer Particles { Particle p[]; } buf;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.count)) return;

    vec2 pos = buf.p[i].pos;
    vec2 acc = vec2(0.0);

    for (int j = 0; j < pc.count; j++) {
        if (j == int(i)) continue;
        vec2 d = buf.p[j].pos - pos;
        float distSq = dot(d, d) + pc.softening * pc.softening;
        float invDist = inversesqrt(distSq);
        float invDist3 = invDist * invDist * invDist;
        acc += pc.gravity * d * invDist3;
    }

    buf.p[i].vel += acc * pc.dt;
    buf.p[i].pos += buf.p[i].vel * pc.dt;

    // Wrap around [-1, 1] world space
    buf.p[i].pos = mod(buf.p[i].pos + 1.0, 2.0) - 1.0;
}
